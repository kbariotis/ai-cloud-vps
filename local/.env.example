# `make local-up` copies this to local/.env (gitignored) and generates local/.env.sandbox + local/.env.openshell-setup (fake PAT).
# Dummy Google creds are enough to exercise discovery, registration and the 401 path.
# Apps are served at https://localhost:8443/<app>/mcp (Caddy internal CA).
# For a real login, create a Google OAuth client with redirect https://localhost:8443/sandbox/auth/callback.
MCP_DOMAIN=localhost:8443
ACME_EMAIL=dev@example.invalid
ALLOWED_EMAIL=you@example.com
GOOGLE_CLIENT_ID=dummy.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-secret
# smoke.sh registers a client with https://example.invalid/cb and expects other hosts to be refused.
ALLOWED_CLIENT_REDIRECT_URIS=https://example.invalid/*
