infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/tfplan
infra/.terraform.lock.hcl.bak

# Ansible
ansible/inventory/hosts.yml
# Personal settings (domain, emails, repos): the repo is public
ansible/inventory/host_vars/*
!ansible/inventory/host_vars/*.example
ansible/.collections/

# Secrets never live in the repo (they come from the environment; see deploy.env.example)
deploy.env
secrets/
.env
.env.*
!.env.example

# Python
__pycache__/
.venv/

# Local test harness
local/.tmp/
local/.tmp-*
local/ansible-target/authorized_keys
