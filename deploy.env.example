# Deploy-time secrets. Ansible reads them from the environment of the machine running
# `make deploy`; nothing is stored in this repo. Copy to deploy.env (gitignored), then either:
#   op run --env-file=deploy.env -- make deploy            # values as op:// references (recommended)
#   set -a; source deploy.env; set +a; make deploy         # plain values in a local file
# In CI, set the same names as repository/environment secrets.

# Hetzner Cloud API token (read & write). make deploy uses it to open/close SSH at the firewall.
HCLOUD_TOKEN=op://Personal/mcp-vps/hcloud_token

# Google Cloud console > APIs & Services > Credentials > OAuth client (Web application).
# Authorized redirect URIs, one per app: https://<mcp_domain>/<app>/auth/callback
MCP_GOOGLE_OAUTH_CLIENT_ID=op://Personal/mcp-vps/google_oauth_client_id
MCP_GOOGLE_OAUTH_CLIENT_SECRET=op://Personal/mcp-vps/google_oauth_client_secret

# Master key (>= 32 chars); each app gets its own derived signing key. Rotating it ends
# every Gemini session. Generate: openssl rand -hex 32
MCP_GATEWAY_JWT_SIGNING_KEY=op://Personal/mcp-vps/gateway_jwt_signing_key

# Optional. Fine-grained PAT for the sandboxes (git + gh), scoped to the repos in
# sandbox_push_repos with Contents: read/write and Pull requests: read/write only.
# Never enters a sandbox: OpenShell injects it at its proxy. Empty = no GitHub access.
MCP_GITHUB_PAT=op://Personal/mcp-vps/github_pat
