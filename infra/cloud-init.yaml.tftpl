#cloud-config
# Minimal bootstrap: just enough for Ansible to take over.
users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - "${ssh_public_key}"

disable_root: true
ssh_pwauth: false

package_update: true
packages:
  - python3
