# cp terraform.tfvars.example terraform.tfvars  (gitignored)
name                = "mcp"
server_type         = "cax21"
location            = "fsn1"
admin_user          = "ops"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# SSH closed at rest. `make deploy` / `make ssh-open` open it to your current IP just-in-time.
ssh_allowed_cidrs = []

# DNS stays at your current provider: after apply, create A/AAAA for your MCP subdomain
# (e.g. mcp.example.com) pointing at `tofu output dns_records`.
